{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Atlas Evidence v1.0",
  "type": "object",
  "required": [
    "id",
    "source",
    "evidence_type"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "source": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "evidence_type": {
      "type": "string"
    },
    "locator": {
      "type": "object"
    },
    "excerpt": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}