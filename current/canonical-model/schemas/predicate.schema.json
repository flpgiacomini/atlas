{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Atlas Predicate v1.0",
  "type": "object",
  "required": [
    "id",
    "name",
    "subject_types",
    "object_types",
    "temporal_policy"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "name": {
      "type": "string"
    },
    "subject_types": {
      "type": "array"
    },
    "object_types": {
      "type": "array"
    },
    "temporal_policy": {
      "enum": [
        "none",
        "optional",
        "recommended",
        "required"
      ]
    },
    "symmetric": {
      "type": "boolean"
    }
  }
}