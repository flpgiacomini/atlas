{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Atlas Claim v1.0",
  "type": "object",
  "required": [
    "id",
    "statement",
    "stance",
    "support_strength",
    "evidence"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "statement": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "stance": {
      "enum": [
        "supports",
        "contradicts",
        "qualifies",
        "mentions"
      ]
    },
    "support_strength": {
      "enum": [
        "explicit",
        "strong",
        "indirect",
        "weak"
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
      },
      "minItems": 1
    }
  }
}