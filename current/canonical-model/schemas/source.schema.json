{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Atlas Source v1.0",
  "type": "object",
  "required": [
    "id",
    "source_type",
    "title"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "source_type": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "url": {
      "type": [
        "string",
        "null"
      ]
    },
    "zotero_key": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}