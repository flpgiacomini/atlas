    "organization": {"minimum_subject_statements": 3, "required_metadata": ["organization_type"]},
    "brand": {"minimum_subject_statements": 3, "required_metadata": ["brand_status"]},
    "person": {"minimum_subject_statements": 3, "required_metadata": ["roles"]},
    "technology": {"minimum_subject_statements": 3, "required_metadata": ["technology_category"]},
    "component": {"minimum_subject_statements": 3, "required_metadata": ["component_type"]},
    "facility": {"minimum_subject_statements": 3, "required_metadata": ["facility_type"]},
    "place": {"minimum_subject_statements": 2, "required_metadata": ["place_type"]},
    "competition": {"minimum_subject_statements": 3, "required_metadata": ["competition_type"]},
    "team": {"minimum_subject_statements": 3, "required_metadata": []},
    "circuit": {"minimum_subject_statements": 3, "required_metadata": ["circuit_status"]},
    "circuit_layout": {"minimum_subject_statements": 3, "required_metadata": ["length_km"]},
    "event": {"minimum_subject_statements": 3, "required_metadata": ["event_type", "realization_status"]},
    "entry": {"minimum_subject_statements": 6, "required_metadata": ["entry_type"]}
