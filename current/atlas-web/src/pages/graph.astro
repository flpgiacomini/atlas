---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Rede"><div class="container page-intro"><div class="hero-kicker">Exploração</div><h1>Encontre um caminho pela história.</h1><p class="lead">A rede usa somente relações publicadas pelo build canônico.</p><section class="card graph-controls"><label>Origem <input id="from-name" list="atlas-nodes" placeholder="Ex.: Porsche 917" /></label><label>Destino <input id="to-name" list="atlas-nodes" placeholder="Ex.: Richard Attwood" /></label><button id="find-path" class="secondary-btn">Encontrar caminho</button><datalist id="atlas-nodes"></datalist></section><div id="path-result" class="path-result" aria-live="polite"></div><div id="global-graph" class="viz" role="img" aria-label="Visualização do caminho entre entidades"></div></div><script>
  import cytoscape from "cytoscape";
  const base=document.documentElement.dataset.base??"/"; const graph=await fetch(`${base}data/graph-index.json`).then(response=>response.json()); const byName=new Map(graph.nodes.map((node:any)=>[node.name.toLocaleLowerCase("pt-BR"),node])); const byId=new Map(graph.nodes.map((node:any)=>[node.id,node])); const adjacency=new Map(); for(const node of graph.nodes)adjacency.set(node.id,[]);for(const edge of graph.edges){adjacency.get(edge.s)?.push({...edge,next:edge.o});adjacency.get(edge.o)?.push({...edge,next:edge.s});}const dataList=document.querySelector("#atlas-nodes")!;dataList.replaceChildren(...graph.nodes.map((node:any)=>{const option=document.createElement("option");option.value=node.name;return option;}));
  function resolve(name:string){return byName.get(name.trim().toLocaleLowerCase("pt-BR"));} function bfs(start:string,end:string,maxDepth=7){const queue:Array<[string,number]>=[[start,0]],parents=new Map<string,any>([[start,null]]);while(queue.length){const [current,depth]=queue.shift()!;if(current===end)break;if(depth>=maxDepth)continue;for(const edge of adjacency.get(current)||[]){if(parents.has(edge.next))continue;parents.set(edge.next,{prev:current,edge});queue.push([edge.next,depth+1]);}}if(!parents.has(end))return null;const nodes=[],edges=[];let current:any=end;while(current){nodes.push(current);const parent:any=parents.get(current);if(parent){edges.push(parent.edge);current=parent.prev}else current=null;}return{nodes:nodes.reverse(),edges:edges.reverse()};}
  let cy:any=null;function render(path:any){const box=document.querySelector("#path-result")!;box.replaceChildren();if(!path){box.textContent="Nenhum caminho encontrado em até 7 saltos.";return;}const strip=document.createElement("div");strip.className="path-strip";path.nodes.forEach((id:string,index:number)=>{if(index){const arrow=document.createElement("b");arrow.textContent="→";strip.append(arrow);}const link=document.createElement("a");link.href=`${base}e/${id}/`;link.textContent=(byId.get(id) as any)?.name;strip.append(link);});box.append(strip);const nodeIds=new Set(path.nodes);const nearEdges=graph.edges.filter((edge:any)=>nodeIds.has(edge.s)||nodeIds.has(edge.o)).slice(0,100);const ids=new Set([...path.nodes,...nearEdges.flatMap((edge:any)=>[edge.s,edge.o])]);const elements=[...[...ids].map((id:any)=>({data:{id,label:(byId.get(id) as any)?.name,type:(byId.get(id) as any)?.type,onPath:nodeIds.has(id)}})),...nearEdges.map((edge:any)=>({data:{id:edge.id,source:edge.s,target:edge.o,label:edge.p,onPath:path.edges.some((item:any)=>item.id===edge.id)}}))];cy?.destroy();cy=cytoscape({container:document.querySelector<HTMLElement>("#global-graph"),elements,style:[{selector:"node",style:{"background-color":"#26383b","label":"data(label)","color":"#f2eadb","font-size":9,"text-wrap":"wrap","text-max-width":105,"text-valign":"bottom","text-margin-y":7,"width":32,"height":32}},{selector:"node[onPath]",style:{"background-color":"#c95037","width":44,"height":44}},{selector:"edge",style:{"width":1,"line-color":"#7f8d89","target-arrow-shape":"triangle","target-arrow-color":"#7f8d89","curve-style":"bezier","label":"data(label)","font-size":7,"color":"#66706c"}},{selector:"edge[onPath]",style:{"width":3,"line-color":"#c95037","target-arrow-color":"#c95037"}}] as any,layout:{name:"cose",animate:false,fit:true,padding:35,nodeRepulsion:9000,idealEdgeLength:95}});cy.on("tap","node",(event:any)=>location.href=`${base}e/${event.target.id()}/`);}
  document.querySelector("#find-path")?.addEventListener("click",()=>{const origin=resolve((document.querySelector("#from-name") as HTMLInputElement).value) as any;const destination=resolve((document.querySelector("#to-name") as HTMLInputElement).value) as any;if(!origin||!destination){document.querySelector("#path-result")!.textContent="Selecione duas entidades existentes.";return;}render(bfs(origin.id,destination.id));});const initial=new URLSearchParams(location.search).get("from");if(initial)(document.querySelector("#from-name") as HTMLInputElement).value=initial;
</script></BaseLayout>
