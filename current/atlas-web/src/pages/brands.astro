---
import BaseLayout from "../layouts/BaseLayout.astro";
import pages from "../data/generated/entity-pages.json";
import census from "../data/generated/brand-census.json";
import { withBase } from "../lib/urls";
const brands = pages.filter((page:any) => page.type === "brand").map((brand:any) => {
  const vehicles = pages.filter((page:any) => page.type === "vehicle" && page.outgoing.some((relation:any) => relation.predicate === "marketed_under" && relation.object_entity_id === brand.id));
  const eventIds = new Set(vehicles.flatMap((vehicle:any) => (vehicle.events ?? []).map((event:any) => event.id)));
  return { ...brand, vehicleCount: vehicles.length, eventCount: eventIds.size };
}).sort((a:any,b:any) => a.name.localeCompare(b.name, "pt-BR"));
const researchByWave = Object.entries(census.waves).map(([wave]) => ({ wave, items: census.items.filter((item:any) => item.wave === wave && item.decision === "needs_research") }));
---
<BaseLayout title="Marcas" description="Explore a história das marcas automotivas por seus veículos, tecnologias, organizações e eventos documentados.">
  <div class="container page-intro" data-pagefind-body>
    <div class="hero-kicker">Acervo por marca</div><h1>As marcas também têm uma história.</h1>
    <p class="lead">Explore cada marca por meio dos automóveis e marcos relacionados no banco canônico. O censo possui {census.candidates} candidatas em 12 ondas; {census.published} já cumprem o gate de publicação e {census.needs_research} permanecem em pesquisa.</p>
    <section class="brand-controls card"><label for="brand-query">Filtrar marcas</label><input id="brand-query" type="search" placeholder="Nome da marca…" autocomplete="off" /><span id="brand-count" aria-live="polite">{brands.length} marcas</span></section>
    <div class="brand-grid" id="brand-grid">{brands.map((brand:any) => <article data-brand={brand.name.toLocaleLowerCase("pt-BR")}><a href={withBase(`e/${brand.id}/`)}><img src={withBase(brand.media.thumbnail)} alt="" width="480" height="320" loading="lazy" /><div><span class="type-pill">Marca</span><h2>{brand.name}</h2><p>{brand.description}</p><footer><strong>{brand.vehicleCount}</strong> automóveis <strong>{brand.eventCount}</strong> marcos</footer></div></a></article>)}</div>
    <section class="brand-research"><div class="section-heading"><div><div class="hero-kicker">Censo em expansão</div><h2>Marcas em pesquisa</h2></div><p>Estas candidatas já pertencem ao registry M01–M12, mas não recebem página factual antes da reconciliação de fontes, organizações, modelos e períodos.</p></div>{researchByWave.map((group:any) => <details><summary><strong>{group.wave}</strong><span>{group.items.length} candidatas</span></summary><ul>{group.items.map((item:any) => <li>{item.name}</li>)}</ul></details>)}</section>
  </div>
  <script>
    const query=document.querySelector<HTMLInputElement>("#brand-query");const cards=[...document.querySelectorAll<HTMLElement>("[data-brand]")];const count=document.querySelector<HTMLElement>("#brand-count");query?.addEventListener("input",()=>{const term=query.value.trim().toLocaleLowerCase("pt-BR");let visible=0;for(const card of cards){const show=!term||(card.dataset.brand??"").includes(term);card.hidden=!show;if(show)visible++;}if(count)count.textContent=`${visible} ${visible===1?"marca":"marcas"}`;});
  </script>
</BaseLayout>
