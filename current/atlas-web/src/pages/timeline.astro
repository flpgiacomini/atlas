---
import BaseLayout from "../layouts/BaseLayout.astro";
import timeline from "../data/generated/timeline.json";
import { safeJsonForHtml } from "../lib/labels";
---
<BaseLayout title="Tempo"><div class="container page-intro"><div class="hero-kicker">Tempo</div><h1>Uma cronologia derivada das evidências.</h1><p class="lead">Eventos publicados a partir de <code>occurred_on</code>, sem criar uma base histórica paralela.</p><section class="card timeline-controls"><label>De <input id="year-from" type="number" value="1885" /></label><label>Até <input id="year-to" type="number" value="2026" /></label><label>Filtrar <input id="timeline-query" type="search" placeholder="evento, marca, tecnologia…" /></label></section><div id="timeline-count" class="muted" aria-live="polite"></div><div id="timeline-list" class="timeline-list"></div></div><script type="application/json" id="timeline-data" set:html={safeJsonForHtml(timeline)}></script><script>
  const rows=JSON.parse(document.querySelector("#timeline-data")?.textContent||"[]"); const from=document.querySelector<HTMLInputElement>("#year-from")!; const to=document.querySelector<HTMLInputElement>("#year-to")!; const query=document.querySelector<HTMLInputElement>("#timeline-query")!; const list=document.querySelector("#timeline-list")!; const count=document.querySelector("#timeline-count")!; const base=document.documentElement.dataset.base??"/";
  const render=()=>{ const first=Number(from.value||1885),last=Number(to.value||2026),needle=query.value.trim().toLocaleLowerCase("pt-BR"); const output=rows.filter((row:any)=>{const year=Number(String(row.date).slice(0,4));return year>=Math.min(first,last)&&year<=Math.max(first,last)&&(!needle||row.name.toLocaleLowerCase("pt-BR").includes(needle));}); count.textContent=`${output.length} eventos`; list.replaceChildren(...output.map((event:any)=>{const link=document.createElement("a");link.href=`${base}e/${event.id}/`;const time=document.createElement("time");time.textContent=event.date;const name=document.createElement("span");name.textContent=event.name;link.append(time,name);return link;})); };
  [from,to,query].forEach(element=>element.addEventListener("input",render)); render();
</script></BaseLayout>
