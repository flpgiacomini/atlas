---
import { label } from "../lib/labels";
const { outgoing = [] } = Astro.props;
const facts = outgoing.filter((item:any) => item.object_type !== "entity");
---
<section><div class="section-heading compact"><div><div class="hero-kicker">Registro</div><h2>Fatos</h2></div></div><div class="relation-list">{facts.length ? facts.map((record:any) => <article class="record"><div class="pred">{label(record.predicate)}</div><div class="record-value">{String(record.value ?? "")}</div><span class:list={["status",record.resolution_status === "disputed" && "disputed"]}>{label(record.resolution_status)}</span>{record.sources?.length > 0 && <details><summary>Evidência · {record.sources.length} fonte(s)</summary>{record.sources.map((source:any) => <p><a href={source.url} target="_blank" rel="noreferrer">{source.title}</a><small>{source.publisher} · {label(source.stance)} / {label(source.support_strength)}</small></p>)}</details>}</article>) : <p class="empty-state">Nenhum fato escalar publicado para esta entidade.</p>}</div></section>
