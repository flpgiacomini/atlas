---
import { label } from "../lib/labels";
import { withBase } from "../lib/urls";
const { outgoing = [], incoming = [] } = Astro.props;
const labels:any = { genealogy:"Genealogia",industry:"Indústria",people:"Pessoas",technology:"Tecnologia",geography:"Geografia",motorsport:"Motorsport",events:"Eventos",other:"Outras relações" };
const order = ["genealogy","industry","people","technology","motorsport","geography","events","other"];
const groups:any = {};
for (const statement of outgoing.filter((item:any)=>item.object_type === "entity")) (groups[statement.group] ??= []).push({...statement,direction:"out"});
for (const statement of incoming) (groups[statement.group] ??= []).push({...statement,direction:"in"});
---
<div class="semantic-groups">{order.filter(group => groups[group]?.length).map(group => <section class="semantic-group"><h3>{labels[group]}</h3><div class="relation-list">{groups[group].map((record:any) => <article class="record"><div class="pred"><span aria-hidden="true">{record.direction === "out" ? "→" : "←"}</span> {label(record.predicate)}</div><a href={withBase(`e/${record.direction === "out" ? record.object_entity_id : record.subject_entity_id}/`)}>{record.direction === "out" ? record.object_name : record.subject_name}</a><span class:list={["status",record.resolution_status === "disputed" && "disputed"]}>{label(record.confidence)}</span>{record.sources?.length > 0 && <details><summary>Evidência · {record.sources.length} fonte(s)</summary>{record.sources.map((source:any) => <p><a href={source.url} target="_blank" rel="noreferrer">{source.title}</a><small>{source.publisher} · {label(source.stance)} / {label(source.support_strength)}</small></p>)}</details>}</article>)}</div></section>)}</div>
