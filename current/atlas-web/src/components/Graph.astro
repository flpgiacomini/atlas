---
import { safeJsonForHtml } from "../lib/labels";
interface Props { graph: any; }
const { graph } = Astro.props;
---
<section class="viz-section"><div class="section-heading compact"><div><div class="hero-kicker">Conexões</div><h2>Rede em dois saltos</h2></div></div><div id="entity-graph" class="viz" role="img" aria-label="Grafo das entidades relacionadas"></div><details class="viz-fallback"><summary>Ver relações em formato textual</summary><ul>{graph.edges.map((edge:any) => <li>{graph.nodes.find((node:any)=>node.id===edge.s)?.name} — {edge.p} → {graph.nodes.find((node:any)=>node.id===edge.o)?.name}</li>)}</ul></details><script type="application/json" id="entity-graph-data" set:html={safeJsonForHtml(graph)}></script></section>
<script>
  import cytoscape from "cytoscape";
  const raw = document.querySelector("#entity-graph-data")?.textContent;
  if (raw) {
    const data = JSON.parse(raw); const base = document.documentElement.dataset.base ?? "/";
    const cy = cytoscape({container:document.querySelector<HTMLElement>("#entity-graph"),elements:[...data.nodes.map((node:any)=>({data:{id:node.id,label:node.name,type:node.type}})),...data.edges.map((edge:any)=>({data:{id:edge.id,source:edge.s,target:edge.o,label:edge.p}}))],style:[{selector:"node",style:{"background-color":"#26383b","label":"data(label)","color":"#f2eadb","font-size":10,"text-wrap":"wrap","text-max-width":110,"text-valign":"bottom","text-margin-y":8,"width":34,"height":34}},{selector:`node[id = "${data.root}"]`,style:{"background-color":"#c95037","width":48,"height":48}},{selector:"node[type = 'event']",style:{"shape":"diamond","background-color":"#4b6970"}},{selector:"edge",style:{"width":1,"line-color":"#8f9b96","target-arrow-color":"#8f9b96","target-arrow-shape":"triangle","curve-style":"bezier","label":"data(label)","font-size":7,"color":"#5f6864"}}] as any,layout:{name:"cose",animate:false,fit:true,padding:30,nodeRepulsion:8000,idealEdgeLength:90}});
    cy.on("tap","node",(event:any)=>{ const id=event.target.id(); if(id!==data.root) location.href=`${base}e/${id}/`; });
  }
</script>
