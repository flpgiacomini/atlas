---
import "vis-timeline/styles/vis-timeline-graph2d.min.css";
import { safeJsonForHtml } from "../lib/labels";
interface Props { events: any[]; }
const { events } = Astro.props;
---
<section class="viz-section"><div class="section-heading compact"><div><div class="hero-kicker">Tempo</div><h2>Timeline relacionada</h2></div></div>{events.length ? <div id="entity-timeline" class="viz" aria-label="Linha do tempo dos eventos relacionados"></div> : <p class="empty-state">Nenhum evento datado diretamente relacionado.</p>}<script is:inline type="application/json" id="entity-timeline-data" set:html={safeJsonForHtml(events)}></script></section>
<script>
  import { DataSet } from "vis-data"; import { Timeline } from "vis-timeline";
  const raw=document.querySelector("#entity-timeline-data")?.textContent; const element=document.querySelector<HTMLElement>("#entity-timeline");
  if(raw && element){ const rows=JSON.parse(raw); const items:any=new DataSet(rows.map((row:any,index:number)=>{ let start=row.date; if(/^\d{4}$/.test(start)) start += "-01-01"; else if(/^\d{4}-\d{2}$/.test(start)) start += "-01"; return {id:index,content:row.name,start,title:`${row.date} · ${row.name}`}; })); new Timeline(element,items,{stack:true,orientation:"top",zoomable:true}); }
</script>
