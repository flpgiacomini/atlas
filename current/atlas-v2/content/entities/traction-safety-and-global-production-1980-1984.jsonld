":"Audi AG","url":"https://www.audi.com/en/company-history-17227","trust":"institutional","verifiedAt":"2026-08-24"},{"id":"atlas:source:mercedes-airbag-history","type":"Source","title":"Mercedes-Benz secures fundamental airbag patent","publisher":"Mercedes-Benz Media","url":"https://media.mercedes-benz.com/article/afabe33e-b2bc-4154-aa3a-2557c2a0b64f","trust":"institutional","verifiedAt":"2026-08-24"},{"id":"atlas:source:honda-us-production-history","type":"Source","title":"75 Years of Honda History — U.S. automobile production","publisher":"Honda Motor Co.","url":"https://global.honda/en/about/history-digest/75years-history/chapter1/section2/page2.html","trust":"institutional","verifiedAt":"2026-08-24"}],"evidence":[{"id":"atlas:evidence:audi-quattro-1980","type":"Evidence","source":"atlas:source:audi-company-history-quattro","evidenceType":"manufacturer-history","locator":{"month":"1980-03"},"notes":"A Audi registra a estreia em Genebra e o papel da tração integral permanente na reposição técnica da marca."},{"id":"atlas:evidence:mercedes-airbag-1981","type":"Evidence","source":"atlas:source:mercedes-airbag-history","evidenceType":"manufacturer-history","locator":{"years":"1980-1981"},"notes":"A Mercedes-Benz registra as primeiras entregas e a estreia pública do airbag de motorista com tensionador de cinto."},{"id":"atlas:evidence:honda-ohio-1982","type":"Evidence","source":"atlas:source:honda-us-production-history","evidenceType":"manufacturer-history","locator":{"date":"1982-11-01"},"notes":"A Honda registra o primeiro Accord de Ohio e a formação de fornecedores e mão de obra locais."}],"metadata":{"editorial_level":"editorial","editorial_batch":"V2-1980S-01","region_cluster":"Mundo 1980-1999"}}
