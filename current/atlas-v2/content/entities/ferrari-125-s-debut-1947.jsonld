{"@context":"https://flpgiacomini.github.io/atlas/context/v2.jsonld","id":"atlas:event:ferrari-125-s-debut-1947","type":"Event","name":"Ferrari 125 S: nasce uma marca nas pistas","aliases":["Primeira Ferrari 125 S"],"description":"A 125 S tornou-se em 1947 o primeiro automóvel a levar o nome Ferrari e vinculou desde a origem a identidade da marca à competição.","claims":[{"id":"atlas:claim:ferrari-125-s-first-drive-1947","type":"Claim","subject":"atlas:event:ferrari-125-s-debut-1947","predicate":"occurred-on","object":{"type":"date","value":"1947-03-12","precision":"day"},"sources":["atlas:source:ferrari-125-s-anniversary"],"evidence":["atlas:evidence:ferrari-125-s-1947"],"confidence":"high","validity":{"from":"1947-03-12","until":"1947-03-12","precision":"day"}}],"sources":[{"id":"atlas:source:ferrari-125-s-anniversary","type":"Source","title":"Ferrari's Anniversary Celebrations","publisher":"Ferrari N.V.","url":"https://www.ferrari.com/content/dam/ferrari-fcom/old/pdf/cos_ferrari_inizio_celebrazioni_70_anni_eng.pdf","trust":"institutional","verifiedAt":"2026-08-24"}],"evidence":[{"id":"atlas:evidence:ferrari-125-s-1947","type":"Evidence","source":"atlas:source:ferrari-125-s-anniversary","evidenceType":"manufacturer-history","locator":{"date":"1947-03-12"},"notes":"A Ferrari registra a primeira partida e teste da 125 S, primeiro carro a levar o nome da marca, e sua estreia em competição dois meses depois."}],"metadata":{"editorial_level":"editorial","editorial_batch":"V2-POSTWAR-01","region_cluster":"Europa 1945-1959"}}
