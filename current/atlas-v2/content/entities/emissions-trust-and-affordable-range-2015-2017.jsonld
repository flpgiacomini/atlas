{"@context":"https://flpgiacomini.github.io/atlas/context/v2.jsonld","id":"atlas:event:emissions-trust-and-affordable-range-2015-2017","type":"Event","name":"Emissões, confiança e autonomia acessível: 2015–2017","aliases":["Do Dieselgate ao Model 3"],"description":"A discrepância entre laboratório e rua rompe a confiança no diesel enquanto elétricos de maior autonomia procuram preço e volume compatíveis com mercados amplos.","claims":[{"id":"atlas:claim:epa-volkswagen-2015","type":"Claim","subject":"atlas:event:emissions-trust-and-affordable-range-2015-2017","predicate":"began-on","object":{"type":"date","value":"2015-09-18","precision":"day"},"sources":["atlas:source:epa-volkswagen-violations"],"evidence":["atlas:evidence:epa-vw-notice-2015"],"confidence":"high","validity":{"from":"2015-09-18","until":"2015-09-18","precision":"day"}},{"id":"atlas:claim:bolt-arrival-2016","type":"Claim","subject":"atlas:event:emissions-trust-and-affordable-range-2015-2017","predicate":"involved","object":"A General Motors iniciou no fim de 2016 a chegada do Chevrolet Bolt EV 2017, com autonomia estimada pela EPA de 238 milhas.","sources":["atlas:source:gm-bolt-2016"],"evidence":["atlas:evidence:gm-bolt-2016"],"confidence":"high","validity":{"from":"2016","until":"2016","precision":"year"}},{"id":"atlas:claim:model3-deliveries-2017","type":"Claim","subject":"atlas:event:emissions-trust-and-affordable-range-2015-2017","predicate":"ended-on","object":{"type":"date","value":"2017-07","precision":"month"},"sources":["atlas:source:tesla-model3-2017"],"evidence":["atlas:evidence:tesla-model3-july-2017"],"confidence":"high","validity":{"from":"2017-07","until":"2017-07","precision":"month"}}],"sources":[{"id":"atlas:source:epa-volkswagen-violations","type":"Source","title":"Learn About Volkswagen Violations","publisher":"U.S. Environmental Protection Agency","url":"https://www.epa.gov/vw/learn-about-volkswagen-violations","trust":"government","verifiedAt":"2026-08-24"},{"id":"atlas:source:g