    {"id":"atlas:evidence:porsche-901-frankfurt-debut","type":"Evidence","source":"atlas:source:porsche-original-911-masterpiece","evidenceType":"manufacturer-archive","locator":{"date":"1963-09-12"},"notes":"A Porsche registra a apresentação do sucessor do 356, ainda denominado 901, no IAA de Frankfurt em 12 de setembro de 1963."},
