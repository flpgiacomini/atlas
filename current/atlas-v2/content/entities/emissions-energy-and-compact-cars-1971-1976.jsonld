ifiedAt":"2026-08-24"},{"id":"atlas:source:volkswagen-golf-i","type":"Source","title":"The beginning: Golf I — 1974 to 1983","publisher":"Volkswagen Newsroom","url":"https://www.volkswagen-newsroom.com/en/40-years-of-golf-2666/the-beginning-golf-i-1974-to-1983-2677","trust":"institutional","verifiedAt":"2026-08-24"},{"id":"atlas:source:honda-accord-1976","type":"Source","title":"Honda introduces new hatchback sedan","publisher":"Honda Motor Co.","url":"https://global.honda/en/newsroom/news/1976/4760507.html","trust":"institutional","verifiedAt":"2026-08-24"}],"evidence":[{"id":"atlas:evidence:honda-cvcc-1972","type":"Evidence","source":"atlas:source:honda-cvcc-history","evidenceType":"manufacturer-history","locator":{"date":"1972-10-11"},"notes":"A Honda registra a apresentação do CVCC e testes que demonstraram conformidade com os requisitos de emissões de 1975."},{"id":"atlas:evidence:volkswagen-golf-1974","type":"Evidence","source":"atlas:source:volkswagen-golf-i","evidenceType":"manufacturer-history","locator":{"month":"1974-03"},"notes":"A Volkswagen registra o início da produção e a mudança para motor transversal dianteiro, tração dianteira e carroceria hatchback."},{"id":"atlas:evidence:honda-accord-1976","type":"Evidence","source":"atlas:source:honda-accord-1976","evidenceType":"contemporary-release","locator":{"date":"1976-05-07"},"notes":"O comunicado registra lançamento, motor CVCC, consumo, emissões e início das exportações aos Estados Unidos."}],"metadata":{"editorial_level":"editorial","editorial_batch":"V2-1970S-01","region_cluster":"Mundo 1960-1979"}}
